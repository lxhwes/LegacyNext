package-as: LegacyNext

enable-nolib-creation: no

# Release notes on CurseForge and GitHub are this file, whole, not the git log
# (release.sh:1091-1101, 2422, 3273 at packager e50a250).
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# The addon lives in a subdirectory so the repo root can hold specs, docs and the vendored
# reference checkout. This lifts LegacyNext/ up to the package root.
# Verified against BigWigsMods/packager on 2026-09-19 (dry run, see docs/distribution.md).
move-folders:
  LegacyNext/LegacyNext: LegacyNext

ignore:
  - spec
  - docs
  - tools
  - vendor
  - .github
  - .claude
  - .busted
  - .gitignore
  - .luacheckrc
  - .pkgmeta
  - CLAUDE.md
