# forever-tools settings for LegacyNext. Parsed as KEY=value, never sourced.
# Prose-level rules (capture commands, queue format, hard constraints) live in CLAUDE.md.
FT_PROJECT=LegacyNext
FT_ADDON_DIRS="LegacyNext"
FT_ADDON_EXCLUDE=""
FT_TOC="LegacyNext/LegacyNext.toc"
FT_WATCHLIST=".claude/forever-tools/watchlist.txt"
FT_CITED_DOCS="docs CLAUDE.md LegacyNext"
FT_INTERNALS_DOC="docs/legacy-internals.md"
FT_QUEUE="docs/ingame-commands.md"
FT_BUILD_LOG="docs/beta-builds.md"
FT_BUCKETS="Legacy addons=/Blizzard_Legacy;Achievement UI=/Blizzard_AchievementUI/;Major factions and talents=/Blizzard_(MajorFactions|SharedTalentUI)/"
FT_LUAC="tools/lua51/bin/luac"
# SetAchievementSearchString is global state shared with Blizzard's Achievement UI;
# LoadAddOn changes what is loaded for the rest of the session.
FT_FORBIDDEN_APIS="SetAchievementSearchString|LoadAddOn"
